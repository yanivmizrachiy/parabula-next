{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "פתח תצוגה מקדימה",
      "type": "shell",
      "dependsOn": ["parabula-next: preview server"],
      "command": "start http://127.0.0.1:5179/preview",
      "problemMatcher": []
    },
    {
      "label": "parabula-next: preview server",
      "type": "shell",
      "command": "npm run preview",
      "isBackground": true,
      "problemMatcher": [
        {
          "owner": "parabula-preview",
          "pattern": {
            "regexp": "^(.*)$"
          },
          "background": {
            "activeOnStart": true,
            "beginsPattern": ".*",
            "endsPattern": "Preview server running:.*"
          }
        }
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": false
      }
    },
    {
      "label": "parabula-next: build",
      "type": "shell",
      "command": "npm run build",
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "parabula-next: verify",
      "type": "shell",
      "command": "npm run verify",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "parabula-next: test",
      "type": "shell",
      "command": "npm test",
      "group": "test",
      "problemMatcher": []
    }
  ]
}