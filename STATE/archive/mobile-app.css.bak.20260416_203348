
:root{
  --mobile-gap:12px;
  --mobile-radius:16px;
  --mobile-border:#dbe3ef;
  --mobile-bg:#f4f7fb;
  --mobile-card:#ffffff;
  --mobile-text:#0f172a;
  --mobile-muted:#475569;
  --mobile-accent:#0f4fd6;
}

html,body{
  margin:0;
  padding:0;
  background:var(--mobile-bg);
  color:var(--mobile-text);
  max-width:100%;
  overflow-x:hidden;
}

body{
  font-family:Rubik,Assistant,Arial,sans-serif;
}

.mobile-app-shell{
  width:100%;
  max-width:100%;
  margin:0 auto;
  padding:calc(env(safe-area-inset-top,0px) + 10px) 10px calc(env(safe-area-inset-bottom,0px) + 90px);
  box-sizing:border-box;
}

.mobile-app-header,
.mobile-welcome-card,
.mobile-topic-strip-wrap,
.mobile-topic-panel,
.mobile-preview-panel{
  background:var(--mobile-card);
  border:1px solid var(--mobile-border);
  border-radius:var(--mobile-radius);
  box-shadow:0 8px 24px rgba(15,23,42,.06);
}

.mobile-app-header{
  display:flex;
  flex-direction:column;
  gap:10px;
  padding:14px;
  margin-bottom:12px;
}

.mobile-app-title-wrap{
  display:flex;
  flex-direction:column;
  gap:6px;
}

.mobile-app-title-wrap strong{
  font-size:22px;
  line-height:1.2;
}

.mobile-app-title-wrap span{
  color:var(--mobile-muted);
  font-size:14px;
}

.mobile-app-header-actions{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}

.mobile-app-chip,
.mobile-app-header-actions button{
  min-height:44px;
  padding:10px 14px;
  border-radius:999px;
  border:1px solid var(--mobile-border);
  background:#fff;
  color:var(--mobile-text);
  text-decoration:none;
  font-size:14px;
}

.mobile-welcome-card{
  padding:14px;
  margin-bottom:12px;
  display:flex;
  flex-direction:column;
  gap:12px;
}

.mobile-welcome-copy{
  display:flex;
  flex-direction:column;
  gap:6px;
}

.mobile-welcome-copy strong{
  font-size:18px;
}

.mobile-welcome-copy span{
  color:var(--mobile-muted);
  font-size:14px;
  line-height:1.45;
}

.mobile-welcome-actions{
  display:grid;
  grid-template-columns:1fr 1fr;
  gap:8px;
}

.mobile-welcome-actions button{
  min-height:46px;
  border:none;
  border-radius:12px;
  background:var(--mobile-accent);
  color:#fff;
  font-size:15px;
}

.mobile-topic-cards-home{
  display:grid;
  grid-template-columns:1fr;
  gap:10px;
  margin-bottom:12px;
}

.mobile-topic-home-card{
  width:100%;
  text-align:right;
  padding:14px;
  border-radius:16px;
  border:1px solid var(--mobile-border);
  background:#fff;
  display:flex;
  flex-direction:column;
  gap:6px;
}

.mobile-topic-home-card strong{
  font-size:17px;
}

.mobile-topic-home-card span,
.mobile-topic-home-card small{
  color:var(--mobile-muted);
}

.mobile-topic-strip-wrap{
  padding:10px;
  margin-bottom:12px;
  position:sticky;
  top:0;
  z-index:20;
  backdrop-filter:blur(8px);
}

.mobile-topic-strip{
  display:flex;
  gap:8px;
  overflow-x:auto;
  padding-bottom:2px;
  scroll-snap-type:x proximity;
}

.mobile-topic-strip::-webkit-scrollbar{
  height:6px;
}

.mobile-topic-btn{
  flex:0 0 auto;
  min-height:40px;
  padding:8px 14px;
  border-radius:999px;
  border:1px solid var(--mobile-border);
  background:#fff;
  color:var(--mobile-text);
  scroll-snap-align:start;
  white-space:nowrap;
}

.mobile-topic-btn.active{
  background:var(--mobile-accent);
  color:#fff;
  border-color:var(--mobile-accent);
}

.mobile-main-grid{
  display:flex;
  flex-direction:column;
  gap:12px;
}

.mobile-topic-panel{
  padding:12px;
}

.mobile-panel-head{
  display:flex;
  flex-direction:column;
  gap:4px;
  margin-bottom:10px;
}

.mobile-panel-head strong{
  font-size:18px;
}

.mobile-panel-head span{
  color:var(--mobile-muted);
  font-size:13px;
}

.mobile-search-row{
  margin-bottom:10px;
}

.mobile-search-row input{
  width:100%;
  min-height:44px;
  border:1px solid var(--mobile-border);
  border-radius:12px;
  padding:0 12px;
  font-size:15px;
  box-sizing:border-box;
}

.mobile-topic-pages{
  display:grid;
  grid-template-columns:1fr;
  gap:8px;
  max-height:none;
  overflow:visible;
}

.mobile-page-card{
  width:100%;
  text-align:right;
  padding:12px;
  border-radius:14px;
  border:1px solid var(--mobile-border);
  background:#fff;
  display:flex;
  flex-direction:column;
  gap:6px;
}

.mobile-page-card strong{
  font-size:15px;
  line-height:1.35;
}

.mobile-page-card span{
  color:var(--mobile-muted);
  font-size:13px;
}

.mobile-page-card.active{
  border-color:var(--mobile-accent);
  box-shadow:0 0 0 2px rgba(15,79,214,.08);
}

.mobile-preview-panel{
  padding:12px;
}

.mobile-preview-head{
  display:flex;
  flex-direction:column;
  gap:10px;
  margin-bottom:10px;
}

.mobile-preview-copy{
  display:flex;
  flex-direction:column;
  gap:4px;
}

.mobile-preview-copy strong{
  font-size:18px;
  line-height:1.3;
}

.mobile-preview-copy span{
  color:var(--mobile-muted);
  font-size:13px;
}

.mobile-preview-actions{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:8px;
}

.mobile-preview-actions button{
  min-height:44px;
  border:1px solid var(--mobile-border);
  border-radius:12px;
  background:#fff;
  font-size:14px;
}

.mobile-book-progress{
  display:flex;
  flex-direction:column;
  gap:4px;
  color:var(--mobile-muted);
  font-size:13px;
  margin-bottom:10px;
}

.mobile-loading-state{
  margin-bottom:10px;
  color:var(--mobile-accent);
  font-size:14px;
}

.mobile-a4-stage{
  width:100%;
  overflow:hidden;
  border-radius:14px;
  background:#eef3f9;
}

.mobile-a4-frame{
  width:100%;
  min-height:65vh;
  background:#eef3f9;
}

#mobilePageFrame{
  width:100%;
  min-height:65vh;
  border:none;
  background:#fff;
  border-radius:14px;
}

.mobile-app-bottom-nav{
  position:fixed;
  left:0;
  right:0;
  bottom:0;
  z-index:40;
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:6px;
  padding:10px 10px calc(env(safe-area-inset-bottom,0px) + 10px);
  background:rgba(255,255,255,.96);
  border-top:1px solid var(--mobile-border);
  backdrop-filter:blur(10px);
}

.mobile-app-bottom-nav button{
  min-height:44px;
  border-radius:12px;
  border:1px solid var(--mobile-border);
  background:#fff;
  font-size:12px;
  padding:6px 4px;
}

.mobile-empty{
  padding:18px;
  text-align:center;
  color:var(--mobile-muted);
  border:1px dashed var(--mobile-border);
  border-radius:14px;
  background:#fff;
}

@media (min-width: 900px){
  .mobile-app-shell{
    max-width:1400px;
    padding:16px 16px 100px;
  }

  .mobile-topic-cards-home{
    grid-template-columns:repeat(3,1fr);
  }

  .mobile-main-grid{
    display:grid;
    grid-template-columns:360px minmax(0,1fr);
    gap:14px;
    align-items:start;
  }

  .mobile-topic-panel{
    position:sticky;
    top:78px;
    max-height:calc(100vh - 120px);
    overflow:auto;
  }

  .mobile-preview-actions{
    grid-template-columns:repeat(4,1fr);
  }

  .mobile-book-progress{
    flex-direction:row;
    justify-content:space-between;
  }

  .mobile-app-bottom-nav{
    grid-template-columns:repeat(7,1fr);
    max-width:1200px;
    margin:0 auto;
    left:50%;
    transform:translateX(-50%);
    border:1px solid var(--mobile-border);
    border-bottom:none;
    border-top-left-radius:18px;
    border-top-right-radius:18px;
  }
}
