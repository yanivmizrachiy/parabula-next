:root{
  --bg:#eef3f8;
  --card:#ffffff;
  --line:#d9e2ec;
  --text:#0f172a;
  --muted:#475569;
  --accent:#1d4ed8;
  --accent-soft:#dbeafe;
}

*{box-sizing:border-box}
html,body{
  margin:0;
  padding:0;
  background:var(--bg);
  color:var(--text);
  font-family:Arial,Helvetica,sans-serif;
}
body{min-height:100vh}

.app-shell{
  width:100%;
  max-width:980px;
  margin:0 auto;
  padding:10px 10px 92px;
}

.topbar,
.resume-box,
.topics-panel,
.current-box,
.reader-box{
  background:var(--card);
  border:1px solid var(--line);
  border-radius:18px;
  box-shadow:0 8px 20px rgba(15,23,42,.06);
  margin-bottom:10px;
}

.topbar{
  padding:12px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.topbar-main{
  min-width:0;
  display:flex;
  flex-direction:column;
  gap:4px;
}

.app-title{
  font-size:1.45rem;
  line-height:1.2;
}

.app-meta{
  color:var(--muted);
  font-size:.95rem;
}

.topbar-actions,
.resume-actions,
.bottom-nav,
.topic-strip{
  display:flex;
  gap:8px;
  flex-wrap:wrap;
}

button{
  appearance:none;
  border:1px solid #c7d2e0;
  background:#fff;
  color:var(--text);
  border-radius:12px;
  min-height:44px;
  padding:0 14px;
  font-size:1rem;
  font-weight:600;
}

button:disabled{
  opacity:.45;
}

.resume-box{
  padding:12px;
  display:flex;
  align-items:center;
  justify-content:space-between;
  gap:10px;
}

.resume-text{
  display:flex;
  flex-direction:column;
  gap:4px;
}

.resume-text span,
.current-copy span,
.reader-copy span,
.reader-progress span{
  color:var(--muted);
}

.topics-panel{
  padding:12px;
}

.section-title{
  font-size:1rem;
  font-weight:700;
  margin-bottom:10px;
}

.topic-strip{
  overflow:auto;
  flex-wrap:nowrap;
  padding-bottom:2px;
}

.topic-btn{
  white-space:nowrap;
  flex:0 0 auto;
}

.topic-btn.active{
  border-color:var(--accent);
  background:var(--accent-soft);
  color:#0b3ea8;
}

.current-box{
  padding:12px;
  display:flex;
  flex-direction:column;
  gap:10px;
}

.current-copy{
  display:flex;
  flex-direction:column;
  gap:4px;
}

#currentTopicTitle{
  font-size:1.25rem;
  line-height:1.2;
}

#globalSearch{
  width:100%;
  min-height:46px;
  border:1px solid #c7d2e0;
  border-radius:12px;
  padding:0 14px;
  font-size:1rem;
}

.pages-list{
  display:flex;
  flex-direction:column;
  gap:8px;
  margin-bottom:10px;
}

.page-card{
  width:100%;
  text-align:right;
  background:var(--card);
  border:1px solid var(--line);
  border-radius:16px;
  padding:12px;
  display:flex;
  flex-direction:column;
  gap:4px;
}

.page-card strong{
  font-size:1rem;
  line-height:1.35;
}

.page-card span{
  color:var(--muted);
  font-size:.92rem;
}

.page-card.active{
  border-color:var(--accent);
  box-shadow:0 0 0 3px rgba(29,78,216,.14);
}

.reader-box{
  padding:12px;
}

.reader-head{
  display:flex;
  flex-direction:column;
  gap:8px;
  margin-bottom:10px;
}

.reader-copy{
  display:flex;
  flex-direction:column;
  gap:4px;
}

#currentPageTitle{
  font-size:1.15rem;
  line-height:1.3;
}

.reader-progress{
  display:flex;
  flex-direction:column;
  gap:4px;
  font-size:.95rem;
}

.loading-state{
  margin-bottom:10px;
  background:#eff6ff;
  border:1px solid #bfdbfe;
  color:#1d4ed8;
  border-radius:12px;
  padding:10px 12px;
}

.frame-wrap{
  background:#e8eef5;
  border:1px solid var(--line);
  border-radius:16px;
  padding:8px;
}

#mobilePageFrame{
  width:100%;
  height:68vh;
  border:0;
  background:#fff;
  border-radius:12px;
}

.bottom-nav{
  position:fixed;
  right:0;
  left:0;
  bottom:0;
  z-index:50;
  background:rgba(255,255,255,.96);
  border-top:1px solid var(--line);
  padding:10px;
  justify-content:center;
  backdrop-filter:blur(8px);
}

.bottom-nav button{
  min-width:88px;
}

.empty-box{
  background:var(--card);
  border:1px dashed var(--line);
  border-radius:16px;
  padding:18px 14px;
  color:var(--muted);
  text-align:center;
}

@media (min-width:900px){
  .reader-head{
    flex-direction:row;
    justify-content:space-between;
    align-items:flex-start;
  }
  .reader-progress{
    align-items:flex-end;
    text-align:left;
  }
  #mobilePageFrame{
    height:74vh;
  }
}


/* mobile-reader-cleanup-2 */
.frame-wrap{
  padding:6px !important;
}
#mobilePageFrame{
  height:74vh !important;
}
.reader-box{
  position:relative;
}
.pages-list{
  padding-bottom:4px;
}
.bottom-nav{
  gap:6px !important;
}
.bottom-nav button{
  flex:1 1 30% !important;
}
@media (max-width:640px){
  .app-shell{
    padding:8px 8px 96px;
  }
  .topbar,
  .resume-box,
  .topics-panel,
  .current-box,
  .reader-box{
    border-radius:14px !important;
  }
  #mobilePageFrame{
    height:72vh !important;
  }
}


/* a4-fit-mobile */
.frame-wrap{
  background:#dfe7f0 !important;
  padding:4px !important;
  overflow:hidden !important;
}
#mobilePageFrame{
  width:100% !important;
  height:78vh !important;
  background:#eef3f8 !important;
}
.reader-box{
  overflow:hidden !important;
}
@media (max-width:640px){
  #mobilePageFrame{
    height:80vh !important;
  }
}


.topics-panel.is-collapsed .topic-strip,
.topics-panel.is-collapsed .section-title-pages,
.topics-panel.is-collapsed .pages-list{
  display:none !important;
}
.section-title-pages{
  margin-top:10px;
}
.bottom-nav button{
  flex:1 1 22%;
}
