{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parabula Next topics.json",
  "type": "object",
  "required": ["generatedAt", "siteUrl", "totalPages", "curriculum", "topics"],
  "additionalProperties": false,
  "$defs": {
    "curriculumNode": {
      "type": "object",
      "required": ["id", "name", "directCount", "pageCount"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^g[789](\\.[A-Za-z0-9]+)*$" },
        "name": { "type": "string", "minLength": 1 },
        "extension": { "const": true },
        "directCount": { "type": "integer", "minimum": 0 },
        "pageCount": { "type": "integer", "minimum": 0 },
        "pages": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "integer", "minimum": 1 }
        },
        "children": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/curriculumNode" }
        }
      }
    }
  },
  "properties": {
    "generatedAt": { "type": "string", "minLength": 1 },
    "siteUrl": { "type": "string", "pattern": "^https://" },
    "totalPages": { "type": "integer", "minimum": 1 },
    "curriculum": {
      "type": "object",
      "required": ["source", "totalNodes", "leafNodes", "emptyLeafNodes", "nodes"],
      "additionalProperties": false,
      "properties": {
        "source": { "type": "string", "minLength": 1 },
        "totalNodes": { "type": "integer", "minimum": 1 },
        "leafNodes": { "type": "integer", "minimum": 1 },
        "emptyLeafNodes": { "type": "integer", "minimum": 0 },
        "nodes": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/curriculumNode" }
        }
      }
    },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "count", "pages"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 1 },
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["number", "file", "title", "h1", "topic", "curriculumId", "previewPath", "siteUrl"],
              "additionalProperties": false,
              "properties": {
                "number": { "type": "integer", "minimum": 1 },
                "file": { "type": "string", "pattern": "^עמוד-\\d+\\.html$" },
                "title": { "type": "string", "minLength": 1 },
                "h1": { "type": "string", "minLength": 1 },
                "topic": { "type": "string", "minLength": 1 },
                "curriculumId": { "type": "string", "pattern": "^g[789](\\.[A-Za-z0-9]+)+$" },
                "previewPath": { "type": "string", "minLength": 1 },
                "siteUrl": { "type": "string", "pattern": "^https://" }
              }
            }
          }
        }
      }
    }
  }
}
