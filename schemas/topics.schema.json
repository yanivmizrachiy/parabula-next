{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Parabula Next topics.json",
  "type": "object",
  "required": ["generatedAt", "siteUrl", "totalPages", "topics"],
  "additionalProperties": false,
  "properties": {
    "generatedAt": { "type": "string", "minLength": 1 },
    "siteUrl": { "type": "string", "pattern": "^https://" },
    "totalPages": { "type": "integer", "minimum": 1 },
    "topics": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "count", "pages"],
        "additionalProperties": false,
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "count": { "type": "integer", "minimum": 1 },
          "pages": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["number", "file", "title", "h1", "topic", "previewPath", "siteUrl"],
              "additionalProperties": false,
              "properties": {
                "number": { "type": "integer", "minimum": 1 },
                "file": { "type": "string", "pattern": "^עמוד-\\d+\\.html$" },
                "title": { "type": "string", "minLength": 1 },
                "h1": { "type": "string", "minLength": 1 },
                "topic": { "type": "string", "minLength": 1 },
                "previewPath": { "type": "string", "minLength": 1 },
                "siteUrl": { "type": "string", "pattern": "^https://" }
              }
            }
          }
        }
      }
    }
  }
}
