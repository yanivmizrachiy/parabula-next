# Normalize line endings to LF on every platform.
# Without this, Windows (core.autocrlf=true) checks generated JSON out as CRLF
# while the generators write LF, so `curriculum:check` and the systems-manifest
# test fail locally even though they pass in Linux CI. LF everywhere fixes it.
* text=auto eol=lf

# Binary assets — never normalize.
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff  binary
*.woff2 binary
*.pdf  binary
