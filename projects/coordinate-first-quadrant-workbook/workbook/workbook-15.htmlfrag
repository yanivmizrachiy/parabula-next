</section></div><script>
(() => {
 const NS='http://www.w3.org/2000/svg'; let counter=0;
 const E=(tag,a={},t='')=>{const n=document.createElementNS(NS,tag);Object.entries(a).forEach(([k,v])=>{if(v!==''&&v!==null&&v!==undefined)n.setAttribute(k,String(v))});if(t!=='')n.textContent=t;return n};
 const data=(c,k,d=[])=>{try{return JSON.parse(c.dataset[k]||JSON.stringify(d))}catch{return d}};
 function render(c){counter++;const W=520,H=330,L=56,R=30,T=24,B=48,xm=8,ym=6,sx=(W-L-R)/xm,sy=(H-T-B)/ym,X=x=>L+x*sx,Y=y=>H-B-y*sy,id='arr'+counter;
  const s=E('svg',{viewBox:`0 0 ${W} ${H}`,role:'img','aria-label':c.getAttribute('aria-label')||'מערכת צירים ברביע הראשון','shape-rendering':'geometricPrecision','text-rendering':'geometricPrecision'});
  const defs=E('defs'),m=E('marker',{id,viewBox:'0 0 10 10',refX:8.5,refY:5,markerWidth:7,markerHeight:7,orient:'auto-start-reverse'});m.append(E('path',{d:'M0 0 L10 5 L0 10 z',fill:'#1d4ed8'}));defs.append(m);s.append(defs);
  for(let x=0;x<=xm;x++)s.append(E('line',{x1:X(x),y1:Y(0),x2:X(x),y2:Y(ym),stroke:'#e7eaf1','stroke-width':1,'vector-effect':'non-scaling-stroke'}));
  for(let y=0;y<=ym;y++)s.append(E('line',{x1:X(0),y1:Y(y),x2:X(xm),y2:Y(y),stroke:'#e7eaf1','stroke-width':1,'vector-effect':'non-scaling-stroke'}));
  s.append(E('line',{x1:X(0),y1:Y(0),x2:X(xm)+22,y2:Y(0),stroke:'#1f2a44','stroke-width':2.2,'vector-effect':'non-scaling-stroke'}),E('path',{d:`M ${X(xm)+28} ${Y(0)} l-10-5v10z`,fill:'#1f2a44'}),E('line',{x1:X(0),y1:Y(0),x2:X(0),y2:Y(ym)-18,stroke:'#1f2a44','stroke-width':2.2,'vector-effect':'non-scaling-stroke'}),E('path',{d:`M ${X(0)} ${Y(ym)-25} l-5 10h10z`,fill:'#1f2a44'}));
  const xl=data(c,'xlabels',[0,1,2,3,4,5,6,7,8]),yl=data(c,'ylabels',[0,1,2,3,4,5,6]);
  for(let x=1;x<=xm;x++){s.append(E('line',{x1:X(x),y1:Y(0)-4,x2:X(x),y2:Y(0)+4,stroke:'#1f2a44','stroke-width':1.4,'vector-effect':'non-scaling-stroke'}));if(xl[x]!==''&&xl[x]!==null)s.append(E('text',{x:X(x),y:Y(0)+20,'text-anchor':'middle',fill:'#1f2a44','font-size':12,'font-weight':700},String(xl[x]??x)))}
  for(let y=1;y<=ym;y++){s.append(E('line',{x1:X(0)-4,y1:Y(y),x2:X(0)+4,y2:Y(y),stroke:'#1f2a44','stroke-width':1.4,'vector-effect':'non-scaling-stroke'}));if(yl[y]!==''&&yl[y]!==null)s.append(E('text',{x:X(0)-11,y:Y(y)+4,'text-anchor':'end',fill:'#1f2a44','font-size':12,'font-weight':700},String(yl[y]??y)))}
  s.append(E('text',{x:X(0)-10,y:Y(0)+20,'text-anchor':'end',fill:'#1f2a44','font-size':12,'font-weight':800},'O'),E('text',{x:X(xm)+23,y:Y(0)-10,'text-anchor':'middle',fill:'#1f2a44','font-size':14,'font-weight':800},'x'),E('text',{x:X(0)+13,y:Y(ym)-17,'text-anchor':'start',fill:'#1f2a44','font-size':14,'font-weight':800},'y'));
  data(c,'polygons').forEach(p=>s.append(E('polygon',{points:(p.points||[]).map(v=>`${X(v[0])},${Y(v[1])}`).join(' '),fill:'rgba(29,78,216,.08)',stroke:'#1d4ed8','stroke-width':2.2,'vector-effect':'non-scaling-stroke'})));
  data(c,'segments').forEach(g=>s.append(E('line',{x1:X(g.from[0]),y1:Y(g.from[1]),x2:X(g.to[0]),y2:Y(g.to[1]),stroke:g.color||(g.type==='guide'?'#64748b':'#1d4ed8'),'stroke-width':g.type==='guide'?1.7:2.6,'stroke-dasharray':g.dashed?'7 5':'','marker-end':g.arrow?`url(#${id})`:'','vector-effect':'non-scaling-stroke'})));
  data(c,'arrows').forEach(a=>{s.append(E('line',{x1:X(a.from[0]),y1:Y(a.from[1]),x2:X(a.to[0]),y2:Y(a.to[1]),stroke:a.color||'#1d4ed8','stroke-width':2.4,'stroke-dasharray':'8 5','marker-end':`url(#${id})`,'vector-effect':'non-scaling-stroke'}));if(a.label){const mx=(X(a.from[0])+X(a.to[0]))/2,my=(Y(a.from[1])+Y(a.to[1]))/2;s.append(E('text',{x:mx,y:my-8,'text-anchor':'middle',fill:'#1d4ed8','font-size':12,'font-weight':800,'paint-order':'stroke',stroke:'#fff','stroke-width':4},a.label))}});
  data(c,'points').forEach(p=>{s.append(E('circle',{cx:X(p.x),cy:Y(p.y),r:5.1,fill:p.color||'#1d4ed8',stroke:'#fff','stroke-width':1.7,'vector-effect':'non-scaling-stroke'}));if(p.label!==undefined&&p.label!=='')s.append(E('text',{x:X(p.x)+(p.dx??10),y:Y(p.y)+(p.dy??-10),'text-anchor':p.anchor||'start',fill:p.color||'#1d4ed8','font-size':13,'font-weight':900,'paint-order':'stroke',stroke:'#fff','stroke-width':4},p.label||`(${p.x},${p.y})`))});
  data(c,'labelboxes').forEach(b=>{const bx=X(b.at[0]),by=Y(b.at[1]),w=Math.max(70,(b.text||'').length*7+18),hh=28;if(b.to)s.append(E('line',{x1:bx,y1:by+hh/2,x2:X(b.to[0]),y2:Y(b.to[1]),stroke:'#64748b','stroke-width':1.3,'stroke-dasharray':'4 3','vector-effect':'non-scaling-stroke'}));s.append(E('rect',{x:bx-w/2,y:by-hh/2,width:w,height:hh,rx:6,fill:'#fff',stroke:'#94a3b8','stroke-width':1.2}),E('text',{x:bx,y:by+4,'text-anchor':'middle',fill:'#1f2a44','font-size':12,'font-weight':700},b.text))});
  c.replaceChildren(s);
 }
 document.querySelectorAll('.coordinate-grid').forEach(render);
 const sel=document.getElementById('pageSelect'),go=n=>{n=Math.max(1,Math.min(30,n));sel.value=String(n);document.getElementById('page-'+n).scrollIntoView({behavior:'smooth',block:'start'})};sel?.addEventListener('change',e=>go(+e.target.value));document.getElementById('prevPage')?.addEventListener('click',()=>go(+sel.value-1));document.getElementById('nextPage')?.addEventListener('click',()=>go(+sel.value+1));
 const ob=new IntersectionObserver(es=>{const v=es.filter(e=>e.isIntersecting).sort((a,b)=>b.intersectionRatio-a.intersectionRatio)[0];if(v)sel.value=v.target.id.replace('page-','')},{threshold:[.2,.55,.8]});document.querySelectorAll('.sheet').forEach(x=>ob.observe(x));
})();
</script></body></html>